<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The native window stays opaque behind Flutter, WebView and IME resizing. -->
    <style name="NantuanFrameTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#142b23</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">#142b23</item>
        <item name="android:navigationBarColor">#142b23</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="LaunchTheme" parent="@style/NantuanFrameTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@style/NantuanFrameTheme" />
</resources>
